{
  "name": "vipper",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "wxt prepare",
    "verify": "node scripts/verify-all.mjs --jobs 4",
    "verify:serial": "node scripts/verify-all.mjs",
    "verify:affected": "node scripts/verify-all.mjs --affected --jobs 2",
    "verify:quick": "pnpm typecheck && pnpm build && node scripts/verify-all.mjs --affected --jobs 2",
    "verify:list": "node scripts/verify-all.mjs --affected --list"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "pinyin-pro": "^3.29.5"
  }
}
